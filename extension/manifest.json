{
  "manifest_version": 3,
  "name": "My Tab Out",
  "version": "1.1.0",
  "description": "个人新标签页：左侧管理已打开的标签页，右侧集中常用入口，并保留 Tab Out 的整理能力。",
  "permissions": ["tabs", "storage"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Tab Out",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
